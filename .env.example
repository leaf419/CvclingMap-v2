# ============================================================
# BikeFlowGNN v2 部署环境变量模板
# 使用方法: 复制本文件为 .env 并填写实际值
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# 所有变量前缀为 BIKEFLOW_，与 gateway/core/config.py 对应
# ============================================================

# ── 网关监听配置 ──
BIKEFLOW_GATEWAY_HOST=0.0.0.0
BIKEFLOW_GATEWAY_PORT=8000
BIKEFLOW_DEBUG=false

# ── CORS 允许来源（逗号分隔）──
# BIKEFLOW_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ── GeoScene Enterprise Server（比赛规则第5条：服务器端 GIS 核心，必须部署）──
# Server 地址格式: https://<host>:6443/arcgis（默认端口 6443，本机或远程均可）
BIKEFLOW_GEOSCENE_SERVER_URL=https://localhost:6443/arcgis
# 由比赛组委会/GeoScene 管理员生成的 Server Token（发布服务与读取服务需要）
BIKEFLOW_GEOSCENE_SERVER_TOKEN=
# 已发布服务名称（与 tools/geoscene/server_config.json 保持一致）
BIKEFLOW_GEOSCENE_SERVICE_SEGMENTS=BikeSegments_MapService
BIKEFLOW_GEOSCENE_SERVICE_STATIONS=BikeStations_MapService
BIKEFLOW_GEOSCENE_SERVICE_ROUTES=BikeRoutes_GeoCodeService
BIKEFLOW_GEOSCENE_SERVICE_SCENE3D=Beijing3D_WebScene

# ── 天地图底图 Token（底图为境内数据，比赛推荐；申请地址 https://console.tianditu.gov.cn/）──
BIKEFLOW_TIANDITU_TOKEN=

# ── 缓存 ──
BIKEFLOW_CACHE_TTL_HOURS=24
